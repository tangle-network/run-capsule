{
  "name": "@tangle-network/run-capsule",
  "version": "0.6.4",
  "description": "Turn any agent run's trace into a shareable video \u2014 code/terminal/screen/conversation capsule animations, recorded headless to local files, with opt-in upload to a temporary public link. Secrets are redacted before rendering. Consumer of @tangle-network/agent-eval/storyboard.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/run-capsule.git"
  },
  "homepage": "https://github.com/tangle-network/run-capsule#readme",
  "keywords": [
    "agent",
    "trace",
    "video",
    "replay",
    "storyboard",
    "demo",
    "observability",
    "playwright",
    "tangle"
  ],
  "bin": {
    "run-capsule": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-studio.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:cohort-ranges": "node scripts/check-cohort-ranges.mjs",
    "prepublishOnly": "pnpm run check:cohort-ranges && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tangle-network/agent-eval": ">=0.197.0 <0.198.0",
    "@tangle-network/agent-integrations": ">=0.59.2 <0.60.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@tangle-network/agent-interface": "^2.13.1",
    "@tangle-network/brand": "^1.8.0",
    "@tangle-network/sandbox-ui": ">=0.114.0 <0.115.0",
    "@tangle-network/ui": "^11.10.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0"
}
