{
  "name": "@tangle-network/run-capsule",
  "version": "0.6.2",
  "description": "Turn any agent run's trace into a shareable video — code/terminal/screen/conversation capsule animations, recorded headless to local files, with opt-in upload to a temporary public link. Secrets are redacted before rendering. Consumer of @tangle-network/agent-eval/storyboard.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/run-capsule.git"
  },
  "homepage": "https://github.com/tangle-network/run-capsule#readme",
  "keywords": [
    "agent",
    "trace",
    "video",
    "replay",
    "storyboard",
    "demo",
    "observability",
    "playwright",
    "tangle"
  ],
  "bin": {
    "run-capsule": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-studio.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:cohort-ranges": "node scripts/check-cohort-ranges.mjs",
    "prepublishOnly": "pnpm run check:cohort-ranges && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tangle-network/agent-eval": ">=0.193.0 <0.194.0",
    "playwright": "^1.57.0",
    "@tangle-network/agent-integrations": "github:tangle-network/agent-integrations#7a927194cc69f75f1b840e417d67fe03e32e6759"
  },
  "devDependencies": {
    "@tangle-network/agent-interface": "^2.6.0",
    "@tangle-network/brand": "^1.5.0",
    "@tangle-network/sandbox-ui": ">=0.113.3 <0.114.0",
    "@tangle-network/ui": "^11.5.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tangle-network/agent-integrations"
    ]
  }
}
